# HeatShield Sentinel - Environment Configuration Template
# Do not place actual secrets in this file. Copy to .env for local configuration.

# AWS & Bedrock Configuration
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Optional: AWS_PROFILE=default

# Environment & Weather API Configuration
ENVIRONMENT_API_BASE_URL=https://api.open-meteo.com/v1
ENVIRONMENT_API_KEY=
DEFAULT_LATITUDE=22.5726
DEFAULT_LONGITUDE=88.3639
DEFAULT_LOCATION_NAME=Kolkata, West Bengal (Barabazar / Sealdah Ward 48)

# Operational Modes
DEMO_MODE=true
LOG_LEVEL=INFO

# Application Endpoints
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
